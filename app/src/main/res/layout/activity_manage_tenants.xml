<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:text="← Back to Dashboard"
            android:textAllCaps="false"
            android:textColor="#087F8C"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage Tenants"
            android:textColor="#102B46"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Register a new tenant and assign them to a property."
            android:textColor="#60758A"
            android:textSize="14sp" />

        <!-- Tenant Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Full Name"
            android:textColor="#102B46"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTenantName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Enter tenant's full name"
            android:inputType="textCapWords"
            android:minHeight="52dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="#102B46"
            android:textColorHint="#94A3B8" />

        <!-- Phone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Phone Number"
            android:textColor="#102B46"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTenantPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="e.g. 0712345678"
            android:inputType="phone"
            android:minHeight="52dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="#102B46"
            android:textColorHint="#94A3B8" />

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Email Address"
            android:textColor="#102B46"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTenantEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="e.g. tenant@email.com"
            android:inputType="textEmailAddress"
            android:minHeight="52dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="#102B46"
            android:textColorHint="#94A3B8" />

        <!-- Property Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Select Property"
            android:textColor="#102B46"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTenantProperty"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp" />

        <!-- Unit Number -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Unit Number"
            android:textColor="#102B46"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTenantUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="e.g. A1"
            android:inputType="textCapCharacters"
            android:minHeight="52dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="#102B46"
            android:textColorHint="#94A3B8" />

        <!-- Monthly Rent -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Monthly Rent (KSh)"
            android:textColor="#102B46"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTenantRent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="e.g. 15000"
            android:inputType="numberDecimal"
            android:minHeight="52dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="#102B46"
            android:textColorHint="#94A3B8" />

        <!-- Save Tenant Button -->
        <Button
            android:id="@+id/btnSaveTenant"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#087F8C"
            android:text="Save Tenant"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- View Tenants Button -->
        <Button
            android:id="@+id/btnViewTenants"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#087F8C"
            android:text="View All Tenants"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
