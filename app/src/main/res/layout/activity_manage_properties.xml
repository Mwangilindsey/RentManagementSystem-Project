<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Properties"
            android:textColor="#102B46"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Add a new property to your portfolio."
            android:textColor="#60758A"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Property Name"
            android:textColor="#102B46"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPropertyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="e.g. CrestPark Apartments"
            android:inputType="textCapWords"
            android:minHeight="52dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Property Address"
            android:textColor="#102B46"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPropertyAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="e.g. Kileleshwa"
            android:inputType="textCapSentences"
            android:minHeight="52dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Number of Units"
            android:textColor="#102B46"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNumberOfUnits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="e.g. 15"
            android:inputType="number"
            android:minHeight="52dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Monthly Rent per Unit (KSh)"
            android:textColor="#102B46"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMonthlyRent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="e.g. 15000"
            android:inputType="numberDecimal"
            android:minHeight="52dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnSaveProperty"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#087F8C"
            android:text="Save Property"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnViewProperties"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="View All Properties"
            android:textAllCaps="false"
            android:textColor="#087F8C"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
